# Opcional: chave de navegador restrita a Maps Embed API e aos referenciadores HTTP autorizados.
# Nunca use chave de servidor neste arquivo. Copie para .env.local e reinicie o Vite.
VITE_GOOGLE_MAPS_EMBED_KEY=

# Opcional: mapa simultâneo no Rastreamento. Restrinja a chave a Maps JavaScript API
# e aos referenciadores HTTPS do painel; configure um Map ID no Google Cloud.
VITE_GOOGLE_MAPS_JS_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
