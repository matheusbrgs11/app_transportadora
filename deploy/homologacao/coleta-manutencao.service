[Unit]
Description=Coleta - limpeza de turnos, chamados e sessões
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=coleta
Group=coleta
WorkingDirectory=/srv/coleta
EnvironmentFile=/etc/coleta/manutencao.env
ExecStart=/srv/coleta/.venv/bin/python -m coleta_api.maintenance --execute
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077
