[Unit]
Description=Coleta API - homologacao
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=coleta
Group=coleta
WorkingDirectory=/srv/coleta
EnvironmentFile=/etc/coleta/homologacao.env
ExecStart=/srv/coleta/.venv/bin/uvicorn coleta_api.main:create_app --factory --host 127.0.0.1 --port 8001 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
