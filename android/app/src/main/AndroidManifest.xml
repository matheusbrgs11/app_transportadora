    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application android:label="Coleta Motorista" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:icon="@drawable/ic_coleta" android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
